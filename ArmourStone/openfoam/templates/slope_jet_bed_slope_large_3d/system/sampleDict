FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      sampleDict;
}

type sets;

libs ("libsampling.so");

interpolationScheme cellPoint;

setFormat raw;

sets
(
    flatBedLine
    {
        type uniform;
        axis distance;
        start (0.2  0.05  0.05);
        end   (9.8  0.05  0.05);
        nPoints 100;
    }

    slopeLine
    {
        type uniform;
        axis distance;
        start (10.1  0.05  0.05);
        end   (17.8  0.05  4.45);
        nPoints 100;
    }
);

fields
(
    U
    p
);
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      sampleDict;
}

type sets;

libs ("libsampling.so");

interpolationScheme cellPoint;

setFormat raw;

sets
(
    flatBedLine
    {
        type uniform;
        axis distance;
        start (0.2 0.05 0.1);
        end   (24.8 0.05 0.1);
        nPoints 100;
    }

    slopeLine
    {
        type uniform;
        axis distance;
        start (25.1 0.05 0.1);
        end   (59.441 0.05 19.9);
        nPoints 100;
    }
);

fields
(
    U
    p
);

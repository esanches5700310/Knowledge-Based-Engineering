FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0.006;

boundaryField
{
    jetInlet
    {
        type fixedValue;
        value uniform 0.006;
    }

    returnOutlet
    {
        type inletOutlet;
        inletValue uniform 0.006;
        value uniform 0.006;
    }

    flatBed
    {
        type kqRWallFunction;
        value uniform 0.006;
    }

    slope
    {
        type kqRWallFunction;
        value uniform 0.006;
    }

    top
    {
        type symmetryPlane;
    }

    frontAndBack
    {
        type empty;
    }
}

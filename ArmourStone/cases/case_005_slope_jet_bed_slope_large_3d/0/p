FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    farLeft
    {
        type symmetryPlane;
    }

    flatBed
    {
        type zeroGradient;
    }

    slope
    {
        type zeroGradient;
    }

    top
    {
        type symmetryPlane;
    }

    sideLeft
    {
        type symmetryPlane;
    }

    sideRight
    {
        type symmetryPlane;
    }
}
